  "paths": {
    "/v1/assets": {
      "get": {
        "tags": [
          "Assets"
        ],
        "summary": "List holdable assets",
        "operationId": "listAssets",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetsAssetList"
                }
              }
            }
          }
        },
        "x-audience": "public"
      }
    },
    "/v1/assets/shortlist": {
      "get": {
        "tags": [
          "Assets"
        ],
        "summary": "List assets a Balance can be opened with",
        "operationId": "listAssetShortlist",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetsShortlist"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpxErrorEnvelope"
                }
              }
            }
          }
        },
        "x-audience": "public"
      }
    },
    "/v1/exchange_rate": {
      "get": {
        "tags": [
          "Assets"
        ],
        "summary": "Get a spot exchange rate",
        "operationId": "getExchangeRate",
        "parameters": [
          {
            "name": "base",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "quote",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExchangerateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpxErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpxErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpxErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-audience": "shared"
      }
    },
    "/v1/inflow_assets": {
      "get": {
        "tags": [
          "Assets"
        ],
        "summary": "List inflow (swap-source) assets",
